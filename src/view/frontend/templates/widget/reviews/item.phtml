use Infrangible\ETrusted\Block\Widget\Reviews\Item;
use Magento\Framework\Escaper;

/** @var Item $block */
/** @var Escaper $escaper */
$review = $block->getReview();
$trustMarkUrl = $block->getTrustMarkUrl();
?>
<div class="item etrusted-review">
    <?= /* @noEscape */ $block->getRatingHtml($review) ?>
    <div class="etrusted-review-details">
        <div class="etrusted-review-title"><?= $escaper->escapeHtml($review['name'] ?? '') ?></div>
        <div class="etrusted-review-date"><?= $escaper->escapeHtml(__('%1 - verified', $review['date'] ?? '')) ?></div>
        <div class="etrusted-review-comment"><?= $escaper->escapeHtml($review['comment'] ?? '') ?></div>
    </div>
    <?php if ($trustMarkUrl !== ''): ?>
        <div class="etrusted-review-icon">
            <img src="<?= $escaper->escapeUrl($trustMarkUrl) ?>"
                 alt="<?= $escaper->escapeHtmlAttr(__('Trust Mark')) ?>"/>
        </div>
    <?php endif; ?>
</div>
