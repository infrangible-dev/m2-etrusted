<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="infrangible_etrusted" translate="label" type="text" sortOrder="1020" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>eTrusted</label>
            <tab>infrangible</tab>
            <resource>Infrangible_ETrusted::config_infrangible_etrusted</resource>
            <group id="sso" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SSO</label>
                <field id="client_id" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                    <comment>The client ID and the secret of an API client of your eTrusted account.</comment>
                </field>
                <field id="secret" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
            <group id="channel" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Channel</label>
                <field id="channel_id" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Channel ID</label>
                    <comment>The ID of the channel (shop) in your eTrusted account, for example chl-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.</comment>
                </field>
            </group>
            <group id="display" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Display</label>
                <field id="trust_mark" translate="label comment" type="image" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Trust Mark</label>
                    <comment>Image next to every review, for example the trust mark of Trusted Shops. Empty: no image.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Image</backend_model>
                    <upload_dir config="system/filesystem/media" scope_info="1">infrangible/etrusted</upload_dir>
                    <base_url type="media" scope_info="1">infrangible/etrusted</base_url>
                </field>
            </group>
        </section>
    </system>
</config>
