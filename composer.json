{
    "name": "infrangible/m2-etrusted",
    "description": "Shows your Trusted Shops (eTrusted) rating summary and a slider with customer reviews on CMS pages and blocks, loaded from the eTrusted platform.",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Integrations",
        "Content",
        "Hyvä",
        "Trusted Shops reviews",
        "eTrusted review widget",
        "customer review slider"
    ],
    "homepage": "https://www.infrangible.dev/modules/etrusted",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.6",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-page-builder": "~2.2.4",
        "magento/module-widget": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\ETrusted\\": "src"
        }
    }
}
