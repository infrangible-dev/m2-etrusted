    "type": "magento2-module",
    "version": "2.1.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Integrations",
        "Content",
        "Hyvä",
        "Trusted Shops reviews",
        "eTrusted review widget",
        "customer review slider"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-etrusted",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\ETrusted\\": "src"
        }
    }
}
